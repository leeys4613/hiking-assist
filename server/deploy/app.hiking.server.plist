<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.hiking.server</string>
    <!-- 127.0.0.1 에만 바인딩. 외부 노출은 tailscale serve(tailnet 전용)가 맡는다. 0.0.0.0 금지 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/iyeongseob/dev/hiking/server/.venv/bin/uvicorn</string>
        <string>app.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8001</string>
        <string>--proxy-headers</string>
        <string>--forwarded-allow-ips</string>
        <string>127.0.0.1</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/iyeongseob/dev/hiking/server</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/iyeongseob/dev/hiking/server/logs/server.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/iyeongseob/dev/hiking/server/logs/server.err</string>
</dict>
</plist>
